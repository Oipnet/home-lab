# WireGuard config pour la Freebox Ultra (côté client du tunnel NAS↔VPS).
# La Freebox établit le tunnel vers le VPS — le NAS Synology n'a aucune modification à faire.
#
# Configuration dans Freebox OS :
#   Paramètres avancés > VPN > WireGuard > Ajouter un profil client
#   (ou importer ce fichier .conf si l'interface le propose)
#
# Pré-requis sur le VPS (worker-1) :
#   - Exécuter : ansible-playbook playbooks/wireguard-nas.yml
#   - Récupérer SERVER_WG1_PUBKEY (affiché par le playbook)
#   - Récupérer WORKER1_PUBLIC_IP : terraform output worker_public_ips
#
# Procédure complète :
#   1. Exécuter le playbook → note la clé publique worker-1 (SERVER_WG1_PUBKEY)
#   2. Renseigner SERVER_WG1_PUBKEY et WORKER1_PUBLIC_IP dans .env
#   3. Générer la config Freebox : ./scripts/gen-wireguard-nas.sh
#   4. Configurer WireGuard sur la Freebox Ultra avec ce fichier
#   5. Activer le tunnel sur la Freebox
#   6. Relancer le playbook avec la clé publique Freebox :
#        ansible-playbook playbooks/wireguard-nas.yml \
#          -e freebox_wg_pubkey=<CLÉ_PUBLIQUE_FREEBOX>
#   7. Vérifier :
#        ping 10.200.0.1         (depuis la Freebox, si elle a un shell)
#        ping 10.200.0.2         (depuis worker-1, IP WireGuard Freebox)
#        ping 192.168.1.NAS_IP   (depuis worker-1, IP LAN du NAS)
#
# Note NFS sur le NAS :
#   Le NAS recevra des connexions NFS depuis 10.200.0.1 (IP WireGuard worker-1).
#   Dans DSM > Dossier partagé > Autorisations NFS, autoriser :
#     Hôte/IP  : 10.200.0.1
#     Privilège : Lecture/Écriture
#     Squash    : Aucun
#   (le reste du LAN continue de fonctionner normalement)

[Interface]
Address    = 10.200.0.2/32
PrivateKey = CHANGE_ME_FREEBOX_PRIVATE_KEY   # généré par gen-wireguard-nas.sh
# DNS requis par l'interface Freebox — sans effet pour un split tunnel (AllowedIPs restreint)
DNS        = 1.1.1.1

[Peer]
# worker-1 Scaleway — serveur WireGuard NAS tunnel (wg1)
PublicKey           = CHANGE_ME_WORKER1_WG1_PUBLIC_KEY   # SERVER_WG1_PUBKEY dans .env
Endpoint            = CHANGE_ME_WORKER1_PUBLIC_IP:51821   # WORKER1_PUBLIC_IP dans .env
# Seul le trafic vers le subnet du tunnel passe par le VPN (split tunnel)
AllowedIPs          = 10.200.0.0/24
PersistentKeepalive = 25
