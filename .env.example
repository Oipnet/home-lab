# Copier en .env et remplir les valeurs.
# Ce fichier est gitignore — ne jamais committer .env

# ── Scaleway ──────────────────────────────────────────────────────────────────
SCW_ACCESS_KEY="SCWXXXXXXXXXXXXXXXXX"
SCW_SECRET_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
SCW_DEFAULT_PROJECT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ── OpenVPN — tunnel NAS Synology (tun0, worker-1) ───────────────────────────
# WORKER1_PUBLIC_IP : terraform output worker_public_ips (premier élément)
# Utilisé par gen-openvpn-nas.sh pour générer nas.ovpn
WORKER1_PUBLIC_IP=""
OPENVPN_NAS_PORT="1194"         # Port UDP OpenVPN (défaut : 1194)

# ── WireGuard VPN — accès sécurisé Jellyfin (wg0, worker-2) ─────────────────
# WORKER2_PUBLIC_IP : terraform output worker_public_ips (deuxième élément)
WORKER2_PUBLIC_IP="163.172.181.187"
WG_VPN_PORT="51820"

# ── NAS — partage NFS ─────────────────────────────────────────────────────────
NAS_NFS_PATH="/volume1/media"   # Adapter selon le partage NFS du NAS
